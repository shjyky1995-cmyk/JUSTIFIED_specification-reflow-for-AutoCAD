<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Setup</AssemblyName>
    <RootNamespace>Justified.SpecificationReflow.AutoCAD.Setup</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <ProjectReference Include="../Justified.SpecificationReflow.AutoCAD.SetupCore/Justified.SpecificationReflow.AutoCAD.SetupCore.csproj" />
    <EmbeddedResource Include="../../branding/product-icon.png" LogicalName="Justified.SpecificationReflow.AutoCAD.Setup.Assets.note-logo.png" />
    <EmbeddedResource Include="$(InstallerPayloadPath)" LogicalName="Justified.SpecificationReflow.AutoCAD.Setup.InstallerPayload.zip" Condition="'$(InstallerPayloadPath)' != ''" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
</Project>
