{
  "name": "dss-desktop-workbench",
  "version": "0.3.0-bid-preview.2",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.electron.json && tsc -p tsconfig.web.json && vite build",
    "start": "electron .",
    "preview": "vite --host 127.0.0.1",
    "test:worker": "node ../../scripts/test-desktop-worker.mjs",
    "test:flow": "node ../../scripts/test-desktop-flow.mjs",
    "test:content": "node ../../scripts/test-content-library.mjs",
    "test:auto": "node ../../scripts/test-auto-assembly.mjs",
    "test:source": "node ../../scripts/test-source-fidelity.mjs",
    "test:pool": "node ../../scripts/test-pool-reference.mjs",
    "test:parameters": "node ../../scripts/test-desktop-parameters.mjs",
    "test:scroll": "node ../../scripts/run-desktop-scroll.mjs",
    "test:corrosion": "node ../../scripts/test-corrosion-source.mjs",
    "check:candidate": "node ../../scripts/check-desktop-candidate.mjs",
    "test:bidding": "node ../../scripts/test-bidding.mjs",
    "test:bid-assistance": "node ../../scripts/test-bid-assistance.mjs"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
