{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "layout-result.schema.json",
  "title": "LayoutResult",
  "description": "JUSTIFIED 数据协议 LayoutResult 契约（PRD 5.4）。样式已在 renderRuns 中解析，渲染器不得再猜测格式；sourceSlices 不得跨不同段落拼成一段。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentHash", "standardRef", "templateRef", "engineVersion", "measurementProfileHash", "pages", "diagnostics", "statistics"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "documentHash": { "type": "string", "minLength": 1 },
    "standardRef": { "$ref": "#/definitions/assetRef" },
    "templateRef": { "$ref": "#/definitions/assetRef" },
    "engineVersion": { "type": "string", "minLength": 1 },
    "measurementProfileHash": { "type": "string", "minLength": 1 },
    "pages": { "type": "array", "items": { "$ref": "#/definitions/page" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/definitions/diagnostic" } },
    "statistics": { "$ref": "#/definitions/statistics" }
  },
  "definitions": {
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "stage", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning", "info"] },
        "stage": { "enum": ["parse", "protocol", "standard", "measure", "layout", "render"] },
        "message": { "type": "string" },
        "sourceRef": { "$ref": "#/definitions/sourceRef" },
        "details": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraphIndex"],
      "properties": {
        "paragraphIndex": { "type": "integer", "minimum": 0 },
        "runIndex": { "type": "integer", "minimum": 0 },
        "textRange": { "$ref": "#/definitions/textRange" }
      }
    },
    "textRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "length"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 }
      }
    },
    "point2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "bounds2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minX", "minY", "maxX", "maxY"],
      "properties": {
        "minX": { "type": "number" },
        "minY": { "type": "number" },
        "maxX": { "type": "number" },
        "maxY": { "type": "number" }
      }
    },
    "fontEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "bigFont": { "type": "string" },
        "fileIdentity": { "type": "string" }
      }
    },
    "resolvedStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["styleId", "semantic", "font", "textHeight", "widthFactor", "obliqueAngle"],
      "properties": {
        "styleId": { "type": "string", "minLength": 1 },
        "semantic": { "enum": ["normal", "superscript", "subscript"] },
        "font": { "$ref": "#/definitions/fontEntry" },
        "textHeight": { "type": "number" },
        "widthFactor": { "type": "number" },
        "obliqueAngle": { "type": "number" }
      }
    },
    "renderRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "relativeOrigin", "baselineOffset", "resolvedStyle", "measuredAdvance", "inkBounds"],
      "properties": {
        "text": { "type": "string" },
        "relativeOrigin": { "$ref": "#/definitions/point2" },
        "baselineOffset": { "type": "number" },
        "resolvedStyle": { "$ref": "#/definitions/resolvedStyle" },
        "measuredAdvance": { "type": "number" },
        "inkBounds": { "$ref": "#/definitions/bounds2" }
      }
    },
    "visualLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSlices", "text", "measuredWidth", "inkBounds", "renderRuns"],
      "properties": {
        "sourceSlices": { "type": "array", "items": { "$ref": "#/definitions/sourceRef" } },
        "text": { "type": "string" },
        "measuredWidth": { "type": "number", "minimum": 0 },
        "inkBounds": { "$ref": "#/definitions/bounds2" },
        "renderRuns": { "type": "array", "items": { "$ref": "#/definitions/renderRun" } }
      }
    },
    "rowSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowIndex", "baseline", "occupancy"],
      "properties": {
        "rowIndex": { "type": "integer", "minimum": 0 },
        "baseline": { "type": "number" },
        "occupancy": { "enum": ["text", "spacer"] },
        "visualLine": { "$ref": "#/definitions/visualLine" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columnIndex", "rows"],
      "properties": {
        "columnIndex": { "type": "integer", "minimum": 0 },
        "rows": { "type": "array", "items": { "$ref": "#/definitions/rowSlot" } }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageIndex", "pageOffset", "columns"],
      "properties": {
        "pageIndex": { "type": "integer", "minimum": 0 },
        "pageOffset": { "$ref": "#/definitions/point2" },
        "columns": { "type": "array", "items": { "$ref": "#/definitions/column" } }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageCount", "rowCount", "objectCount", "warningCount", "elapsed"],
      "properties": {
        "pageCount": { "type": "integer", "minimum": 0 },
        "rowCount": { "type": "integer", "minimum": 0 },
        "objectCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "elapsed": { "type": "string", "pattern": "^-?[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$" }
      }
    }
  }
}
